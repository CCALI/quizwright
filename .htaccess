# Protect files and directories from prying eyes.
<FilesMatch ".+\.(inc)$">
  Require all granted
</FilesMatch>

# Session settings used to live here as php_value directives. They are inert
# under the PHP-FPM/FastCGI SAPI, so they never took effect. They now live in
# includes/session.php, which must be required before any output and before
# session_start(). Do not re-add them here.
